{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "walkers.org.in" }],
      "destination": "https://www.walkers.org.in/:path*",
      "permanent": true
    }
  ],

  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/products/:slug", "destination": "/api/render?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}